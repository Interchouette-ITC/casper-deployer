{
  "name": "frontend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/frontend/src",
  "prefix": "casper",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:browser",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/frontend",
        "index": "apps/frontend/src/index.html",
        "main": "apps/frontend/src/main.ts",
        "polyfills": "apps/frontend/src/polyfills.ts",
        "tsConfig": "apps/frontend/tsconfig.app.json",
        "webWorkerTsConfig": "libs/util/hihlight-webworker/tsconfig.webworker.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/frontend/src/favicon.ico",
          "apps/frontend/src/favicon.png",
          "apps/frontend/src/assets",
          {
            "input": "node_modules/deployer",
            "glob": "deployer_bg.wasm",
            "output": "assets"
          },
          {
            "input": "node_modules/casper-rust-wasm-sdk",
            "glob": "casper_rust_wasm_sdk_bg.wasm",
            "output": "assets"
          },
          {
            "input": "node_modules/ceps-client-wasm-schema",
            "glob": "ceps_client_wasm_bg.wasm",
            "output": "assets"
          }
        ],
        "styles": [
          "apps/frontend/src/tailwind.css",
          "apps/frontend/src/styles.scss",
          "./node_modules/highlight.js/styles/lightfair.css",
          "./node_modules/toastr/build/toastr.min.css"
        ],
        "scripts": [
          "./node_modules/jquery/dist/jquery.min.js",
          "./node_modules/toastr/build/toastr.min.js"
        ],
        "allowedCommonJsDependencies": ["promise-worker"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "fileReplacements": [
            {
              "replace": "apps/frontend/src/environments/environment.ts",
              "with": "apps/frontend/src/environments/environment.prod.ts"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      }
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "defaultConfiguration": "development",
      "continuous": true,
      "options": {
        "proxyConfig": "apps/frontend/proxy.conf.json",
        "host": "0.0.0.0",
        "port": 4242
      },
      "configurations": {
        "production": {
          "buildTarget": "frontend:build:production",
          "port": 8080
        },
        "development": {
          "buildTarget": "frontend:build:development",
          "port": 4242
        }
      }
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "frontend:build"
      }
    },
    "lint": {
      "options": {
        "args": ["**/*.ts", "**/*.html"]
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      }
    }
  }
}
