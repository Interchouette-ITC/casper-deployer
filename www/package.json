    "casper-rust-wasm-sdk-nodejs": "file:../casper-rust-wasm-sdk/pkg-nodejs",
    "ceps-client-wasm-schema": "file:../ceps-client-wasm-schema/pkg",
    "ceps-client-wasm-schema-nodejs": "file:../ceps-client-wasm-schema/pkg-nodejs",
    "deployer": "file:../wasm/pkg",
    "express": "^5.3.0",
