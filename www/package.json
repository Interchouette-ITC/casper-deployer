{
  "name": "casper-deployer",
  "version": "2.2.2",
  "license": "MIT",
  "scripts": {
    "ng": "nx",
    "postinstall": "node ./decorate-angular-cli.js",
    "start": "npm run start:dev",
    "start:dev": "nx run-many --target=serve --projects=api,frontend --parallel",
    "start:prod": "nx run-many --target=serve --projects=api,frontend --parallel --configuration=production",
    "build": "nx run-many --target=build --projects=api,frontend --parallel --cloud=false && cp server.js dist/server.js",
    "test": "nx run-many --target=test --all --parallel --cloud=false",
    "serve:api": "node dist/apps/api/main.js",
    "serve": "node dist/server.js & node dist/apps/api/main.js",
    "e2e": "nx run api:serve & nx run frontend-e2e:e2e --skip-nx-cache && killall node",
    "cypress": "cypress open --e2e -b chrome -P apps/frontend-e2e"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.2.3",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/platform-browser-dynamic": "22.2.3",
